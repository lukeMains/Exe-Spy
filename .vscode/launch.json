	"version": "0.2.0",
	"configurations": [
		{
			"env": {
				"DISPLAY": "192.168.56.1:0.0"
			},
			"name": "Debug ELF File",
			"type": "debugpy",
			"request": "launch",
			"program": "run.pyw",
			"console": "integratedTerminal",
			"cwd": "${workspaceFolder}",
			"args": [
				"${workspaceFolder}/tests/ls",
				"--debug"
			]
		},
		{
			"env": {
				"DISPLAY": "192.168.56.1:0.0"
			},
			"name": "Debug PE File",
			"type": "debugpy",
			"request": "launch",
			"program": "run.pyw",
			"console": "integratedTerminal",
			"cwd": "${workspaceFolder}",
			"args": [
				"${workspaceFolder}/tests/where.exe",
				"--debug"
			]
		}
	]
}